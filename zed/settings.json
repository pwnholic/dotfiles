{
  "language_models": {
    "openai_compatible": {
      "Surplus Intelligence": {
        "api_url": "https://api.surplusintelligence.ai/v1",
        "available_models": [
          {
            "name": "Qwen 4 Max",
            "max_tokens": 1000000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 128000,
            "reasoning_effort": "max",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "max_tokens_parameter": true
            }
          }
        ]
      }
    }
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "opencode-v2": {
      "default_config_options": {
        "effort": "max",
        "model": "surplus/kimi-k3.1-pro"
      },
      "type": "registry"
    },
    "pi-acp": { "default_config_options": {
                     "model": "surplus/qwen4-max"
                },
                "type": "registry" },
  },
  "icon_theme": "Base Charmed Icons",
  "theme": "Catppuccin Mocha",
  "buffer_font_size": 15,
  "buffer_font_family": "Iosevka Nerd Font Mono",
  "ui_font_family": "Iosevka Nerd Font Propo",
  "line_indicator_format": "short",
  "active_pane_modifiers": {
    "border_size": 1.0,
    "inactive_opacity": 0.8,
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "use_smartcase_search": true,
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "auto_signature_help": true,
  "completion_menu_item_kind": "symbol",
  "completion_menu_scrollbar": "auto",
  "code_lens": "on",
  "semantic_tokens": "combined",
  "inlay_hints": {
    "enabled": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "show_whitespaces": "trailing",
  "wrap_guides": [80, 100, 120],
  "unnecessary_code_fade": 0.5,
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "colorize_brackets": true,
  "toolbar": {
    "code_actions": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_onboarding_banner": false,
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": true,
  },
  "project_panel": {
    "dock": "left",
    "entry_spacing": "standard",
    "bold_folder_labels": true,
    "hide_root": true,
  },
  "terminal": {
    "line_height": "comfortable",
    "max_scroll_history_lines": 100000,
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "git_panel": {
    "dock": "left",
    "file_icons": true,
    "status_style": "label_color",
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 300,
  },
  "auto_install_extensions": {
    "lua": true,
    "toml": true,
    "sql": true,
    "make": true,
    "env": true,
    "jsonl": true,
    "mdx": true,
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "diagnosticMode": "workspace",
          },
        },
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
  },
  "context_servers": {
    "mcp-server-exa-search": {
      "enabled": true,
      "remote": false,
      "settings": {
        "exa_api_key": "626ccca8-97ec-4cc1-b7dc-5d67c4147f20"
      }
    },
    "codebase-memory-mcp": {"command":"/home/pwnholic/.local/bin/codebase-memory-mcp","args":[]}
  },
}
