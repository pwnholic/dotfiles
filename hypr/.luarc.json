{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "Lua 5.4",
        "pathStrict": true
    },
    "workspace": {
        "library": ["/usr/share/hypr/stubs"],
        "checkThirdParty": "Disable"
    },
    "diagnostics": {
        "globals": ["hl"],
        "disable": ["lowercase-global"]
    }
}
