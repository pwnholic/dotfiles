// ════════════════════════════════════════════════════════════════════
//  Key Bindings
//  Docs:    https://github.com/niri-wm/niri/wiki/Configuration:-Key-Bindings
//  Actions: run `niri msg action`      | Noctalia IPC: `noctalia msg --help`
//
//  Dual-monitor aware: horizontal focus/move use the "-or-monitor-*"
//  variants, so at a workspace edge the cursor/column flows onto the
//  adjacent monitor instead of stopping dead.
// ════════════════════════════════════════════════════════════════════
binds {
    // ─── Hotkey Overlay & Inhibit Escape ───
    Mod+Shift+Escape  hotkey-overlay-title="<b>Hotkey Overlay</b>" { show-hotkey-overlay; }
    // Breaks out of apps that grabbed all shortcuts (VMs, remote desktop).
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="<b>Toggle</b> Shortcut Inhibit" { toggle-keyboard-shortcuts-inhibit; }

    // ─── Applications ───
    Mod+Return hotkey-overlay-title="<b>Terminal</b> <span foreground='#7dcfff'>kitty</span>" { spawn-sh "kitty"; }
    Mod+Space  hotkey-overlay-title="<b>Launcher</b> <span foreground='#bb9af7'>Noctalia</span>" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B      hotkey-overlay-title="<b>Browser</b> <span foreground='#e0af68'>Firefox</span>" { spawn "firefox"; }
    Mod+E      hotkey-overlay-title="<b>Files</b> <span foreground='#9ece6a'>Nautilus</span>" { spawn "nautilus"; }

    // ─── Noctalia v5 Panels & Overview ───
    Mod+Shift+V hotkey-overlay-title="<b>Clipboard</b> History" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Alt+Tab    hotkey-overlay-title="<b>Window Switcher</b> <span foreground='#bb9af7'>Noctalia</span>" { spawn-sh "noctalia msg window-switcher"; }
    Mod+O repeat=false hotkey-overlay-title="<b>Overview</b>" { toggle-overview; }
    // Dark/Light theme + niri screen crossfade (freeze → apps redraw → reveal).
    Mod+Slash hotkey-overlay-title="<b>Toggle</b> <span foreground='#e0af68'>Dark</span>/<span foreground='#7dcfff'>Light</span> Theme" { spawn-sh "niri msg action do-screen-transition && noctalia msg theme-mode-toggle"; }

    // ─── Session / Power ───
    Mod+Alt+L       hotkey-overlay-title="<b>Lock</b> Screen" { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+Q     hotkey-overlay-title="<b>Session</b> Menu" { spawn-sh "noctalia msg panel-toggle session"; }
    Ctrl+Alt+Delete hotkey-overlay-title="<b>Quit</b> Niri" { quit; }
    Mod+Shift+P     hotkey-overlay-title="<b>Power Off</b> Monitors <span foreground='#f7768e'>DPMS</span>" { power-off-monitors; }
    Mod+P           hotkey-overlay-title="<b>Power</b> Profile <span foreground='#9ece6a'>(cycle)</span>" { spawn-sh "noctalia msg power-cycle"; }

    // ─── System Toggles (Noctalia) ───
    // Moved off Mod+Shift+C: that combo sits exactly on the terminal's
    // universal copy shortcut (Ctrl+Shift+C), so a Super-slip would toggle
    // caffeine instead of copying. F12 is unbound; overlay keeps it visible.
    Mod+Shift+C hotkey-overlay-title="<b>Caffeine</b> <span foreground='#e0af68'>(inhibit idle)</span>" { spawn-sh "noctalia msg caffeine-toggle"; }
    Mod+Shift+N hotkey-overlay-title="<b>Night Light</b>" { spawn-sh "noctalia msg nightlight-toggle"; }
    Mod+Shift+D hotkey-overlay-title="<b>Do Not Disturb</b>" { spawn-sh "noctalia msg notification-dnd-toggle"; }

    // ─── Hardware Keys (work even when locked) ───
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86Bluetooth allow-when-locked=true { spawn-sh "noctalia msg bluetooth-toggle"; }

    // ─── Window Management ───
    Mod+Q  hotkey-overlay-title="<b>Close</b> Window" { close-window; }
    // Tab = flip back to the previously focused window (vs Alt+Tab switcher).
    Mod+Tab  hotkey-overlay-title="<b>Focus</b> Previous Window" { focus-window-previous; }
    Mod+F  hotkey-overlay-title="<b>Fullscreen</b> Window" { fullscreen-window; }
    // Shift+F = borderless windowed fullscreen (games that dislike real FS).
    Mod+Shift+F  hotkey-overlay-title="<b>Windowed</b> Fullscreen" { toggle-windowed-fullscreen; }
    // T = toggle floating; Shift+T = jump focus between floating & tiling layers.
    Mod+T       hotkey-overlay-title="<b>Toggle</b> Floating" { toggle-window-floating; }
    Mod+Shift+T hotkey-overlay-title="<b>Focus</b> Floating/Tiling" { switch-focus-between-floating-and-tiling; }
    Mod+W  hotkey-overlay-title="<b>Toggle</b> Column Tabbed" { toggle-column-tabbed-display; }
    // M = maximize column (fill width). Shift+M = maximize window to screen edges.
    Mod+M       hotkey-overlay-title="<b>Maximize</b> Column" { maximize-column; }
    Mod+Shift+M hotkey-overlay-title="<b>Maximize</b> Window" { maximize-window-to-edges; }
    // 0 = reset the focused window's height back to automatic.
    Mod+0  hotkey-overlay-title="<b>Reset</b> Window Height" { reset-window-height; }
    // [ / ] = merge the window into the adjacent column, or expel it back out.
    Mod+BracketLeft  hotkey-overlay-title="<b>Consume/Expel</b> Left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="<b>Consume/Expel</b> Right" { consume-or-expel-window-right; }

    // ─── Focus (Vim + Arrows) — column/monitor aware ───
    // At a workspace edge these cross onto the adjacent monitor.
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+H     { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+L     { focus-column-or-monitor-right; }
    Mod+Up   { focus-window-up; }
    Mod+K    { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+J    { focus-window-down; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // ─── Move (Vim + Arrows) — column/monitor aware ───
    Mod+Ctrl+Left  { move-column-left-or-to-monitor-left; }
    Mod+Ctrl+H     { move-column-left-or-to-monitor-left; }
    Mod+Ctrl+Right { move-column-right-or-to-monitor-right; }
    Mod+Ctrl+L     { move-column-right-or-to-monitor-right; }
    Mod+Ctrl+Up   { move-window-up; }
    Mod+Ctrl+K    { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+J    { move-window-down; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }
    // Shift+Up/Down = send the focused WINDOW to the workspace above/below.
    Mod+Shift+Up   { move-window-to-workspace-up; }
    Mod+Shift+Down { move-window-to-workspace-down; }
    // Shift+H/L = swap the focused window with the adjacent column's window.
    Mod+Shift+H { swap-window-left; }
    Mod+Shift+L { swap-window-right; }
    // Alt+Left/Right = send the focused window to the other monitor.
    Mod+Alt+Left  { move-window-to-monitor-left; }
    Mod+Alt+Right { move-window-to-monitor-right; }

    // ─── Scroll ───
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // ─── Workspaces ───
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ─── Column / Window Sizing ───
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C      { center-column; }
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+R       { switch-preset-window-width; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ─── Screenshots ───
    Print       hotkey-overlay-title="<b>Screenshot</b> Region" { spawn-sh "noctalia msg screenshot-region"; }
    Shift+Print hotkey-overlay-title="<b>Screenshot</b> Fullscreen" { spawn-sh "noctalia msg screenshot-fullscreen"; }
    // Focused-window capture (niri builtin → clipboard + screenshot-path).
    Ctrl+Print  hotkey-overlay-title="<b>Screenshot</b> Window" { screenshot-window; }

Mod+Shift+W hotkey-overlay-title="<b>Next</b> Wallpaper" {
    spawn-sh "noctalia msg wallpaper-next";
}

// Mod+Alt+C hotkey-overlay-title="<b>Cast</b> Window" {
//     set-dynamic-cast-window;
// }
//
// Mod+Alt+M hotkey-overlay-title="<b>Cast</b> Monitor" {
//     set-dynamic-cast-monitor;
// }
//
// Mod+Alt+X hotkey-overlay-title="<b>Clear</b> Cast Target" {
//     clear-dynamic-cast-target;
// }
}
