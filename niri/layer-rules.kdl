// ════════════════════════════════════════════════════════════════════
//  Layer-Shell Rules (Noctalia v5 integration)
//  Docs: https://github.com/niri-wm/niri/wiki/Configuration:-Layer-Rules
//        https://docs.noctalia.dev/v5/compositor-settings/niri/
// ════════════════════════════════════════════════════════════════════
//
//  Verified Noctalia v5 layer namespaces (via `niri msg layers`):
//    noctalia-backdrop       — blurred wallpaper for overview backdrop
//    noctalia-wallpaper      — regular wallpaper
//    noctalia-bar-default    — top bar
//    noctalia-dock           — app dock
//    noctalia-notification   — notification popups
//    noctalia-panel-*        — panels (launcher, control-center, etc.)
//    noctalia-attached-panel — attached panels
//    noctalia-osd            — on-screen display (volume/brightness)
//    noctalia-window-switcher — Alt+Tab overlay
// ── Option 1: Blurred Overview Wallpaper (prettier) ───────────────
// Places Noctalia's dedicated backdrop layer (blurred + tinted wallpaper
// copy) within niri's overview backdrop for a smooth blur effect.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
// ── Option 2: Stationary Wallpaper (uncomment if preferred) ───────
// Keeps the regular wallpaper visible at all times (no scroll on
// workspace switch). Comment out Option 1 above if using this.
// layer-rule {
//     match namespace="^noctalia-wallpaper"
//     place-within-backdrop true
// }
// ── Noctalia Surfaces: blur disabled ──────────────────────────────
// Bar: PURE transparent background — no blur behind it. Gaps are
// see-through to the wallpaper/windows; capsules float with their own
// fill + border (configured in Noctalia's bar.toml).
layer-rule {
    match namespace="^noctalia-bar-"
    background-effect {
        blur false
    }
}

// All other Noctalia surfaces (notifications, dock, panels, attached
// panels, OSD): blur off. The regex covers plain namespaces
// (noctalia-notification, noctalia-osd) and prefixed ones such as
// noctalia-panel-launcher / noctalia-panel-control-center.
layer-rule {
    match namespace="^noctalia-(notification|dock|panel|attached-panel|osd)(-|$)"
    background-effect {
        blur false
    }
}
// ── Window Switcher: blur off ─────────────────────────────────────
layer-rule {
    match namespace="^noctalia-window-switcher"
    background-effect {
        blur false
    }
}
// ── Desktop Widgets: blur off ─────────────────────────────────────
layer-rule {
    match namespace="^noctalia-desktop-widget-"
    background-effect {
        blur false
    }
}
// ── Popups (context menus, tray drawer): blur off ─────────────────
layer-rule {
    match namespace="^noctalia-bar"
    popups {
        geometry-corner-radius 8
        background-effect {
            blur false
        }
    }
}

// Block out mako notifications from screencasts.
layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}
    // Neovim GUI / terminal apps:
    // Neovim sendiri biasanya TIDAK punya app-id,
    // karena Neovim berjalan di dalam terminal.
    
