# ~/.config/uwsm/env — sourced by uwsm at session start when using the
# "Hyprland (uwsm-managed)" entry (hyprland-uwsm.desktop). Session-wide vars
# live here; they reach every process the session envelope starts (xdg-autostart,
# systemd units, Hyprland, child apps, ...).

export BROWSER=firefox
export TERM=xterm-kitty
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export ELECTRON_OZONE_PLATFORM_HINT=auto
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=24

# Hyprland uses the Intel iGPU as the primary GPU and keeps the NVIDIA GPU
# available for outputs or explicit application offload.
export AQ_DRM_DEVICES="/dev/dri/intel-igpu:/dev/dri/nvidia-dgpu"
